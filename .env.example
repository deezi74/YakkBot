# YakkBot settings. The installer writes a starter copy to ~/.yakkbot/.env; this file lists everything.
# Values in the process environment win over the file. Never commit a real .env.

# ---- the app ----
PORT=8787
HOST=127.0.0.1                     # 0.0.0.0 opens the app to your network
# YAKK_HOME=~/.yakkbot             # settings, database, bot homes, Library
# APP_URL=http://localhost:8787    # where the app is reached (redirects, OAuth callbacks)
# SERVER_URL=http://localhost:8787

# ---- sign-in ----
YAKK_OWNER=Owner
YAKK_PASSWORD=change-me            # the passphrase; empty disables passphrase sign-in
# DEV_LOGIN=1                      # email-only sign-in for development; never on a reachable address
# ALLOWED_EMAILS=                  # with Google sign-in (Composio): who may sign in

# ---- models for the built-in engine (one is enough; keys can also be added in the app) ----
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# CUSTOM_BASE_URL=                 # any OpenAI-compatible server
# CUSTOM_API_KEY=
# CUSTOM_MODEL=
# YAKK_PROVIDER=anthropic          # which connected provider bots use by default

# ---- engine behaviour ----
# YAKK_ENGINE=native               # or hermes
YAKK_SHELL_APPROVAL=risky          # risky | always | off
# YAKK_CONTEXT_CHARS=400000
# YAKK_MAX_STEPS=60
# MAX_BOTS=12
# PRIMARY_BOT_NAME=Yakk
# PRIMARY_BOT_LABEL=Chief of Staff

# ---- add-ons ----
# XAI_API_KEY=                     # voice calls, dictation, research on X
# XAI_MODEL=grok-4.7
# COMPOSIO_API_KEY=                # connected apps and Google sign-in
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHATS=          # comma-separated chat ids
# TAVILY_API_KEY=                  # web search (else BRAVE_API_KEY, else DuckDuckGo)

# ---- a desktop for the bots ----
# YAKK_COMPUTER=local              # none | local | orgo (default: local when VNC_PORT is set)
# VNC_HOST=127.0.0.1
# VNC_PORT=5901
# VNC_PASSWORD=
# YAKK_DISPLAY=:1

# ---- Hermes engine (YAKK_ENGINE=hermes) ----
# HERMES_BIN=hermes
# HERMES_URL=http://127.0.0.1:8642
# HERMES_HOME_PRIMARY=~/.hermes
# HERMES_KEY=
# EXTRA_MCP_SERVERS=

# ---- Orgo cloud computer (YAKK_COMPUTER=orgo) ----
# ORGO_API_KEY=
# ORGO_COMPUTER_ID=
# HQ_LOCAL=0
